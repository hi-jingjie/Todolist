<view class="page">
  <view class="hero">
    <text class="eyebrow">PLANPROOF · 今日计划</text>
    <text class="title">今天真正做得完什么？</text>
    <text class="subtitle">你的历史实际耗时会校正任务预估；今天的校准系数是 {{calibrationPercent}}%。</text>
  </view>

  <view class="card">
    <text class="card-title">今天可投入的时间</text>
    <view class="capacity-row">
      <view wx:for="{{capacities}}" wx:key="*this" class="capacity {{capacityMinutes === item ? 'capacity--active' : ''}}" data-minutes="{{item}}" bindtap="onCapacitySelect">{{item}} 分钟</view>
    </view>
    <view class="summary"><text>已安排 {{plan.plannedMinutes}} 分钟</text><text>剩余 {{plan.remainingMinutes}} 分钟</text></view>
  </view>

  <view class="section-title">今日安排</view>
  <view wx:if="{{plan.items.length}}">
    <view wx:for="{{plan.items}}" wx:key="id" class="card task-card">
      <view class="task-line"><text class="task-title">{{item.title}}</text><text class="minutes">{{item.adjustedMinutes}} 分钟</text></view>
      <view class="meta">截止：{{item.dueDate || '未设置'}} · {{item.priority}} 优先级</view>
      <view class="actual-row">
        <input class="actual-input" type="number" value="{{item.actualInput}}" placeholder="实际耗时（分钟）" data-id="{{item.id}}" bindinput="onActualInput" />
        <button class="save-btn" data-id="{{item.id}}" bindtap="onSaveActualMinutes">保存</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty">当前没有可以安排的未完成任务。</view>

  <view wx:if="{{overflowText}}" class="section-title overflow-heading">{{overflowText}}</view>
  <view wx:for="{{overflowItems}}" wx:key="id" class="overflow-card">
    <text>{{item.title}}</text>
    <text>{{item.dueDate || '未设置截止日'}}</text>
  </view>
</view>
