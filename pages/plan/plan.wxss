.page { min-height: 100vh; padding: 36rpx 24rpx 70rpx; background: var(--color-bg); box-sizing: border-box; }
.hero { display: flex; flex-direction: column; padding: 28rpx 8rpx 34rpx; }
.eyebrow { color: var(--color-primary); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { margin-top: 14rpx; color: var(--color-text); font-size: 42rpx; font-weight: 700; line-height: 1.25; }
.subtitle { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.55; }
.card { margin-bottom: 20rpx; padding: 26rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-card); box-sizing: border-box; }
.card-title, .section-title { color: var(--color-text); font-size: 29rpx; font-weight: 700; }
.capacity-row { display: flex; gap: 14rpx; margin-top: 20rpx; }
.capacity { flex: 1; padding: 16rpx 8rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-secondary); background: var(--color-bg); font-size: 24rpx; text-align: center; }
.capacity--active { color: #fff; border-color: var(--color-primary); background: var(--color-primary); font-weight: 600; }
.summary, .task-line, .actual-row { display: flex; flex-direction: row; align-items: center; }
.summary { justify-content: space-between; margin-top: 20rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.section-title { margin: 36rpx 8rpx 18rpx; }
.task-line { justify-content: space-between; gap: 14rpx; }
.task-title { flex: 1; color: var(--color-text); font-size: 31rpx; font-weight: 650; line-height: 1.4; }
.minutes { color: var(--color-primary); font-size: 25rpx; font-weight: 600; white-space: nowrap; }
.meta { margin-top: 13rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.actual-row { gap: 14rpx; margin-top: 22rpx; }
.actual-input { flex: 1; height: 76rpx; padding: 0 18rpx; border-radius: var(--radius-md); background: var(--color-bg); color: var(--color-text); font-size: 26rpx; box-sizing: border-box; }
.save-btn { flex: 0 0 128rpx; margin: 0; padding: 18rpx 12rpx; border-radius: var(--radius-md); background: var(--color-primary); color: #fff; font-size: 24rpx; line-height: 1; }
.overflow-heading { color: #9a6700; }
.overflow-card { display: flex; flex-direction: row; justify-content: space-between; margin-bottom: 14rpx; padding: 22rpx 24rpx; border-radius: var(--radius-md); background: rgba(234, 179, 8, .1); color: #765d00; font-size: 25rpx; }
.empty { padding: 42rpx 24rpx; border-radius: var(--radius-lg); background: var(--color-surface); color: var(--color-text-secondary); font-size: 26rpx; text-align: center; }
