<view class="page">
  <view class="header">
    <text class="title">数据概览</text>
    <text class="subtitle">看看最近做成了多少事</text>
  </view>

  <view class="summary-card">
    <text class="summary-label">累计专注</text>
    <text class="summary-value">{{focusText}}</text>
  </view>

  <view class="grid">
    <view class="stat-card">
      <text class="stat-value">{{stats.todayCompleted}}</text>
      <text class="stat-label">今日完成</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.weekCompleted}}</text>
      <text class="stat-label">本周完成</text>
    </view>
    <view class="stat-card">
      <text class="stat-value danger">{{stats.overdueCount}}</text>
      <text class="stat-label">逾期待办</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.activeCount}}</text>
      <text class="stat-label">未完成</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.archivedCount}}</text>
      <text class="stat-label">已归档</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.pinnedCount}}</text>
      <text class="stat-label">置顶中</text>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item" bindtap="onNavTodo">
      <text class="bottom-nav-icon">✓</text>
      <text class="bottom-nav-label">待办</text>
    </view>
    <view class="bottom-nav-item bottom-nav-item--active">
      <text class="bottom-nav-icon">∑</text>
      <text class="bottom-nav-label">统计</text>
    </view>
    <view class="bottom-nav-item" bindtap="onNavArchive">
      <text class="bottom-nav-icon">□</text>
      <text class="bottom-nav-label">归档</text>
    </view>
  </view>
</view>
