.page {
  min-height: 100vh;
  padding: calc(56rpx + env(safe-area-inset-top)) var(--space-lg)
    calc(var(--space-xl) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  box-sizing: border-box;
}

.focus-header {
  margin-bottom: var(--space-xl);
}

.focus-title {
  display: block;
  color: var(--color-text);
  font-size: 44rpx;
  font-weight: 700;
}

.focus-subtitle {
  display: block;
  margin-top: var(--space-sm);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.bound-todo {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-lg);
  box-sizing: border-box;
}

.bound-todo--done {
  border-color: rgba(34, 197, 94, 0.24);
  background: rgba(34, 197, 94, 0.08);
}

.bound-label {
  display: block;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.bound-title {
  display: block;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.bound-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--color-primary);
  font-size: 24rpx;
}

.duration-panel,
.timer-panel {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--space-lg);
  margin-bottom: var(--space-lg);
  box-sizing: border-box;
}

.panel-label {
  display: block;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  margin-bottom: var(--space-md);
}

.duration-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.duration-chip {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 22rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.duration-chip--active {
  background: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
  font-weight: 600;
}

.duration-chip--disabled {
  opacity: 0.58;
}

.timer-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timer-ring {
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: var(--space-md) 0 var(--space-lg);
}

.timer-ring-inner {
  width: 328rpx;
  height: 328rpx;
  border-radius: 50%;
  background: var(--color-surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx var(--color-border);
}

.timer-time {
  color: var(--color-text);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.timer-status {
  margin-top: var(--space-md);
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--color-bg);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-primary);
}

.actions {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
}

.action {
  flex: 1;
  padding: 26rpx 0;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.action-primary {
  background: var(--color-primary);
  color: #ffffff;
}

.action-ghost {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}
