<view class="page">
  <view class="focus-header">
    <text class="focus-title">专注模式</text>
    <text class="focus-subtitle">选择时长，让这一段时间只服务一件事</text>
  </view>

  <view wx:if="{{todoTitle}}" class="bound-todo">
    <text class="bound-label">当前待办</text>
    <text class="bound-title">{{todoTitle}}</text>
    <text class="bound-hint">专注完成后自动标记完成</text>
  </view>
  <view wx:elif="{{completedTodoTitle}}" class="bound-todo bound-todo--done">
    <text class="bound-label">已完成待办</text>
    <text class="bound-title">{{completedTodoTitle}}</text>
  </view>

  <view class="duration-panel">
    <text class="panel-label">专注时长</text>
    <view class="duration-grid">
      <view
        wx:for="{{durations}}"
        wx:key="*this"
        class="duration-chip {{durationMinutes === item ? 'duration-chip--active' : ''}} {{status === 'running' ? 'duration-chip--disabled' : ''}}"
        data-minutes="{{item}}"
        bindtap="onDurationTap"
      >
        {{item}} 分钟
      </view>
    </view>
  </view>

  <view class="timer-panel">
    <view class="timer-ring">
      <view class="timer-ring-inner">
        <text class="timer-time">{{displayTime}}</text>
        <text class="timer-status">{{statusText}}</text>
      </view>
    </view>
    <view class="progress-track">
      <view class="progress-bar" style="width: {{progress}}%;" />
    </view>
  </view>

  <view class="actions">
    <view
      wx:if="{{status !== 'running'}}"
      class="action action-primary"
      bindtap="onStart"
    >
      {{actionText}}
    </view>
    <view
      wx:else
      class="action action-primary"
      bindtap="onPause"
    >
      暂停
    </view>
    <view class="action action-ghost" bindtap="onReset">重置</view>
  </view>
</view>
