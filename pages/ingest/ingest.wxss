.page { min-height: 100vh; padding: 36rpx 24rpx 64rpx; background: var(--color-bg); box-sizing: border-box; }
.hero { display: flex; flex-direction: column; padding: 28rpx 8rpx 34rpx; }
.eyebrow { color: var(--color-primary); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { margin-top: 14rpx; color: var(--color-text); font-size: 42rpx; font-weight: 700; line-height: 1.25; }
.subtitle { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.55; }
.card { margin-bottom: 20rpx; padding: 26rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-card); box-sizing: border-box; }
.card-head, .card-foot, .meta-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-title { flex: 1; color: var(--color-text); font-size: 28rpx; font-weight: 600; }
.count, .hint { color: var(--color-text-secondary); font-size: 23rpx; }
.count--danger, .error { color: var(--color-danger); }
.source-input { width: 100%; min-height: 230rpx; margin-top: 20rpx; padding: 18rpx; border-radius: var(--radius-md); background: var(--color-bg); color: var(--color-text); font-size: 28rpx; line-height: 1.55; box-sizing: border-box; }
.card-foot { margin-top: 20rpx; }
.extract-btn, .confirm-btn { margin: 0; border-radius: var(--radius-md); background: var(--color-primary); color: #fff; font-size: 25rpx; line-height: 1; }
.extract-btn { padding: 19rpx 22rpx; }
.extract-btn[disabled] { background: #bbbcc5; }
.error-panel, .invalid-panel, .empty { margin-bottom: 20rpx; padding: 20rpx 24rpx; border-radius: var(--radius-md); font-size: 25rpx; line-height: 1.5; }
.error-panel { color: #b42318; background: rgba(239, 68, 68, .1); }
.invalid-panel { color: #9a6700; background: rgba(234, 179, 8, .12); }
.results-title { margin: 36rpx 8rpx 18rpx; color: var(--color-text); font-size: 30rpx; font-weight: 700; }
.task-title { color: var(--color-text); font-size: 32rpx; font-weight: 650; line-height: 1.4; }
.meta-row { flex-wrap: wrap; justify-content: flex-start; margin-top: 15rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.evidence { margin-top: 20rpx; padding: 18rpx; border-radius: var(--radius-md); background: var(--color-primary-soft); display: flex; flex-direction: column; }
.evidence-label { color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.evidence-text { margin-top: 7rpx; color: var(--color-text); font-size: 26rpx; line-height: 1.5; }
.confidence, .uncertainty { margin-top: 16rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.uncertainty { color: #9a6700; }
.confirm-btn { margin-top: 24rpx; padding: 21rpx; }
.empty { color: var(--color-text-secondary); background: var(--color-surface); text-align: center; }
