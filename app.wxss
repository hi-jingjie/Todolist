page {
  --color-primary: #5b50e6;
  --color-primary-soft: rgba(91, 80, 230, 0.1);
  --color-danger: #ef4444;
  --color-text: #202128;
  --color-text-secondary: #7a7c87;
  --color-bg: #f6f6f8;
  --color-surface: #ffffff;
  --color-border: #e4e4e7;
  --color-priority-high: #ef4444;
  --color-priority-medium: #eab308;
  --color-priority-low: #22c55e;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --shadow-card: 0 8rpx 32rpx rgba(24, 24, 27, 0.06);
  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  min-height: 100%;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.bottom-nav {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  padding: 8rpx 12rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(228, 228, 231, 0.86);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  z-index: 20;
}

.bottom-nav-item {
  flex: 1;
  min-width: 0;
  height: 82rpx;
  border-radius: 18rpx;
  color: var(--color-text-secondary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bottom-nav-item--active {
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-weight: 600;
}

.bottom-nav-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 4rpx;
  color: currentColor;
  flex-shrink: 0;
  box-sizing: border-box;
}

.bottom-nav-label {
  color: currentColor;
  font-size: 21rpx;
  line-height: 1;
}

.nav-icon-todo {
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.nav-icon-todo view {
  position: absolute;
  left: 13rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.nav-icon-todo view::before {
  content: '';
  position: absolute;
  left: -7rpx;
  top: -1rpx;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: currentColor;
}

.nav-icon-todo view:nth-child(1) { top: 7rpx; }
.nav-icon-todo view:nth-child(2) { top: 15rpx; }
.nav-icon-todo view:nth-child(3) { top: 23rpx; }

.nav-icon-stats {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 3rpx;
  border-bottom: 3rpx solid currentColor;
}

.nav-icon-stats view {
  width: 6rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: currentColor;
}

.nav-icon-stats view:nth-child(1) { height: 11rpx; }
.nav-icon-stats view:nth-child(2) { height: 22rpx; }
.nav-icon-stats view:nth-child(3) { height: 16rpx; }

.nav-icon-archive {
  margin-top: 5rpx;
  height: 27rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.nav-icon-archive::before {
  content: '';
  position: absolute;
  left: -5rpx;
  right: -5rpx;
  top: -8rpx;
  height: 6rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  background: var(--color-surface);
}

.nav-icon-archive view {
  width: 11rpx;
  height: 3rpx;
  margin: 8rpx auto 0;
  border-radius: 3rpx;
  background: currentColor;
}
