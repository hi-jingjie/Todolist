page {
  --color-primary: #4f46e5;
  --color-primary-soft: rgba(79, 70, 229, 0.12);
  --color-danger: #ef4444;
  --color-text: #18181b;
  --color-text-secondary: #71717a;
  --color-bg: #f4f4f5;
  --color-surface: #ffffff;
  --color-border: #e4e4e7;
  --color-priority-high: #ef4444;
  --color-priority-medium: #eab308;
  --color-priority-low: #22c55e;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --shadow-card: 0 8rpx 32rpx rgba(24, 24, 27, 0.06);
  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  min-height: 100%;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.bottom-nav {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 98rpx;
  padding: 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(228, 228, 231, 0.86);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  z-index: 20;
}

.bottom-nav-item {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  border-radius: 22rpx;
  color: var(--color-text-secondary);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.bottom-nav-item--active {
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-weight: 600;
}

.bottom-nav-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  border-radius: 12rpx;
  color: currentColor;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
  flex-shrink: 0;
}

.bottom-nav-label {
  color: currentColor;
  font-size: 24rpx;
  line-height: 1;
}
